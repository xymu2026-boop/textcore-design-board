{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textcore.local/schemas/course_state.schema.json",
  "title": "TextCore Course State",
  "description": "文心 TextCore 一篇课程从上传到产出的全量状态契约（冻结）。所有阶段 S0–S10 读它、写它。版本档位英文 key 见 ADR-004。",
  "type": "object",
  "additionalProperties": false,
  "required": ["course_id", "schema_version", "source", "status"],
  "properties": {
    "course_id": { "type": "string", "description": "course_<year>_<seq>" },
    "schema_version": { "type": "string", "const": "1.0", "description": "契约版本，改字段必须升版 + 走 ADR" },
    "status": {
      "type": "string",
      "enum": ["created", "processing", "completed", "failed", "needs_human"],
      "description": "课程整体处理状态"
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "description": "原始 .docx 文件名" },
        "stored_path": { "type": "string", "description": "data/uploads 下的相对路径" },
        "imported_at": { "type": "string", "format": "date-time" },
        "detected_meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "course_title": { "type": "string" },
            "teacher": { "type": "string" },
            "date": { "type": "string" },
            "student_group": { "type": "string" },
            "content_type_candidates": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "course_types": {
      "type": "object",
      "description": "S2/课型识别结果，混合课不止一个标签",
      "additionalProperties": false,
      "properties": {
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "confidence"],
            "properties": {
              "type": { "$ref": "#/$defs/courseType" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "dominant_type": { "$ref": "#/$defs/courseType" },
        "mixed": { "type": "boolean" }
      }
    },

    "paragraphs": {
      "type": "array",
      "description": "S0 解析产物，不可变，所有后续内容回溯到 pid",
      "items": { "$ref": "#/$defs/paragraph" }
    },

    "preclean": {
      "type": "array",
      "description": "S1 预清洗：标记优先、删除后置（不真删原文）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pid", "labels"],
        "properties": {
          "pid": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "risk": { "$ref": "#/$defs/risk" }
        }
      }
    },

    "segments": {
      "type": "array",
      "description": "S2 话题分割标注（两轮分块法第一轮）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pid", "segment_type", "is_boundary"],
        "properties": {
          "pid": { "type": "string" },
          "segment_type": { "$ref": "#/$defs/segmentType" },
          "is_boundary": { "type": "boolean" }
        }
      }
    },

    "chunks": {
      "type": "array",
      "description": "S3 语义分块",
      "items": { "$ref": "#/$defs/chunk" }
    },

    "chunk_results": {
      "type": "array",
      "description": "S4 分块保真清洗结果",
      "items": { "$ref": "#/$defs/chunkResult" }
    },

    "classics_refs": {
      "type": "array",
      "description": "S5 古文/诗词参考服务回填（旁征博引）",
      "items": { "$ref": "#/$defs/classicsRef" }
    },

    "global": {
      "type": "object",
      "description": "S6 全局合并",
      "additionalProperties": false,
      "properties": {
        "course_summary": { "type": "string" },
        "outline_tree": { "type": "array", "items": { "$ref": "#/$defs/outlineNode" } },
        "main_themes": { "type": "array", "items": { "type": "string" } },
        "merged_review_flags": { "type": "array", "items": { "$ref": "#/$defs/reviewFlag" } }
      }
    },

    "versions": {
      "type": "object",
      "description": "S7 四档版本。key 固定，见 ADR-004；中文显示名前端映射。",
      "additionalProperties": false,
      "required": ["faithful", "concise", "study", "outline"],
      "properties": {
        "faithful": { "$ref": "#/$defs/version" },
        "concise":  { "$ref": "#/$defs/version" },
        "study":    { "$ref": "#/$defs/version" },
        "outline":  { "$ref": "#/$defs/version" }
      }
    },
    "default_version": {
      "type": "string",
      "enum": ["faithful", "concise", "study", "outline"],
      "default": "concise",
      "description": "默认展示档，见 ADR-004"
    },

    "knowledge_cards": {
      "type": "array",
      "description": "S8 知识卡片",
      "items": { "$ref": "#/$defs/knowledgeCard" }
    },

    "writing_materials": {
      "type": "array",
      "description": "S8 作文素材",
      "items": { "$ref": "#/$defs/writingMaterial" }
    },

    "review_flags": {
      "type": "array",
      "description": "S9 汇总的复核标记（含 S5 错字 diff）",
      "items": { "$ref": "#/$defs/reviewFlag" }
    },

    "quality": { "$ref": "#/$defs/quality" },

    "processing_log": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "status"],
            "properties": {
              "stage": { "type": "string", "description": "S0..S10" },
              "status": { "type": "string", "enum": ["pending", "running", "done", "failed", "skipped"] },
              "started_at": { "type": "string", "format": "date-time" },
              "ended_at": { "type": "string", "format": "date-time" },
              "note": { "type": "string" }
            }
          }
        },
        "model_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stage": { "type": "string" },
              "model": { "type": "string" },
              "prompt_tokens": { "type": "integer" },
              "completion_tokens": { "type": "integer" },
              "cost_usd": { "type": "number" }
            }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total_usd": { "type": "number" },
            "total_tokens": { "type": "integer" }
          }
        }
      }
    }
  },

  "$defs": {
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },

    "courseType": {
      "type": "string",
      "enum": ["modern_reading", "essay_method", "essay_feedback", "classical_chinese", "poetry", "humanities_story", "test_strategy", "mixed"]
    },

    "segmentType": {
      "type": "string",
      "enum": ["讲解", "题目", "学生回答", "作文点评", "文言文原文", "古诗词", "课堂管理", "闲聊"]
    },

    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "text", "source_order"],
      "properties": {
        "pid": { "type": "string", "description": "p0001 等，全程不可变" },
        "text": { "type": "string" },
        "speaker": { "type": "string" },
        "ts": { "type": "string", "description": "时间戳如 00:00:09" },
        "style": { "type": "string" },
        "source_order": { "type": "integer", "minimum": 1 }
      }
    },

    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "paragraph_range"],
      "properties": {
        "chunk_id": { "type": "string", "description": "c001 等" },
        "paragraph_range": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 2,
          "description": "[起 pid, 止 pid]"
        },
        "primary_type": { "$ref": "#/$defs/courseType" },
        "context_before": { "type": "string", "description": "上一块 200-400 字摘要" },
        "must_preserve_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "reason"],
            "properties": {
              "text": { "type": "string" },
              "reason": { "type": "string", "description": "如 essay_original_sentence / classical_text / poetry" }
            }
          }
        }
      }
    },

    "chunkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "cleaned_text"],
      "properties": {
        "chunk_id": { "type": "string" },
        "cleaned_text": { "type": "string" },
        "key_points": { "type": "array", "items": { "type": "string" } },
        "student_answer_kept": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["answer", "reason"],
            "properties": {
              "answer": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "review_flags": { "type": "array", "items": { "$ref": "#/$defs/reviewFlag" } },
        "entities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persons": { "type": "array", "items": { "type": "string" } },
            "works": { "type": "array", "items": { "type": "string" } },
            "concepts": { "type": "array", "items": { "type": "string" } }
          }
        },
        "classics_candidates": {
          "type": "array",
          "description": "S4 识别的疑似古文/诗词候选，喂给 S5；禁止凭记忆补全原文",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title"],
            "properties": {
              "title": { "type": "string" },
              "writer": { "type": "string" },
              "raw_span": { "type": "string", "description": "课稿中的疑似原文片段" },
              "kind": { "type": "string", "enum": ["classical", "poetry"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },

    "classicsRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id", "matched"],
      "properties": {
        "ref_id": { "type": "string" },
        "chunk_id": { "type": "string" },
        "matched": { "type": "boolean" },
        "source": { "type": "string", "enum": ["gushiwen", "guwen", "none"], "description": "释义层/全文校验层/未命中" },
        "title": { "type": "string" },
        "writer": { "type": "string" },
        "dynasty": { "type": "string" },
        "canonical_text": { "type": "string", "description": "权威原文，原文以此为准但不静默替换课稿" },
        "translation": { "type": "string" },
        "remark": { "type": "string", "description": "字词注释" },
        "shangxi": { "type": "string", "description": "赏析" },
        "diffs": {
          "type": "array",
          "description": "课稿与权威原文逐字 diff，生成错字复核标记",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["raw", "canonical"],
            "properties": {
              "pid": { "type": "string" },
              "raw": { "type": "string" },
              "canonical": { "type": "string" }
            }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "ref_url": { "type": "string" }
      }
    },

    "outlineNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "level": { "type": "integer", "minimum": 2, "maximum": 4, "description": "h2/h3/h4" },
        "anchor": { "type": "string", "description": "锚点，关联 chunk_id" },
        "chunk_ids": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/outlineNode" } }
      }
    },

    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_md"],
      "properties": {
        "body_md": { "type": "string", "description": "正文 Markdown/HTML 字符串" },
        "compression": { "type": "number", "minimum": 0, "maximum": 1, "description": "相对原文的保留比例" },
        "char_count": { "type": "integer", "minimum": 0 }
      }
    },

    "knowledgeCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "title", "type"],
      "properties": {
        "card_id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["method", "person", "event", "concept", "work", "theme", "mistake"] },
        "summary": { "type": "string" },
        "core_points": { "type": "array", "items": { "type": "string" } },
        "example": { "type": "string", "description": "课堂例子" },
        "related_persons": { "type": "array", "items": { "type": "string" } },
        "related_themes": { "type": "array", "items": { "type": "string" } },
        "source_chunks": { "type": "array", "items": { "type": "string" } },
        "classics_ref_id": { "type": "string", "description": "work 类型可关联一条 classicsRef" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },

    "writingMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "title"],
      "properties": {
        "material_id": { "type": "string" },
        "title": { "type": "string" },
        "theme": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" },
        "usable_expression": { "type": "string" },
        "teacher_comment": { "type": "string" },
        "usage_suggestion": { "type": "string" },
        "source_chunks": { "type": "array", "items": { "type": "string" } },
        "risk": { "$ref": "#/$defs/risk" }
      }
    },

    "reviewFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "reason"],
      "properties": {
        "flag_id": { "type": "string" },
        "pid": { "type": "string", "description": "定位到原文段落" },
        "chunk_id": { "type": "string" },
        "text": { "type": "string", "description": "被标记的内容" },
        "suggestion": { "type": "string", "description": "建议修正，如错字 diff 的 canonical" },
        "reason": { "type": "string" },
        "category": { "type": "string", "enum": ["transcription_error", "uncertain_person", "uncertain_title", "classical_typo", "unclear_reading", "other"] },
        "severity": { "$ref": "#/$defs/risk" },
        "status": { "type": "string", "enum": ["open", "resolved", "dismissed"], "default": "open" }
      }
    },

    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "coverage": { "type": "string", "enum": ["poor", "fair", "good"] },
        "main_risks": { "type": "array", "items": { "type": "string" } },
        "recommended_human_review": { "type": "boolean" }
      }
    }
  }
}
